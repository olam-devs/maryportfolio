---
type Props = {
  email?: string;
  instagram?: string;
};
const { email, instagram } = Astro.props;
---

<footer class="border-t border-black/10 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-2">
    <div>
      <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-[#146D57]">Let’s connect</h3>
      <p class="mt-3 max-w-prose text-neutral-700">
        For partnerships, media, or strategy work, reach out and we’ll make something beautiful.
      </p>
      <div class="mt-5 flex flex-col gap-2 text-sm">
        {email ? <a class="font-semibold text-neutral-900 hover:text-[#E05747]" href={`mailto:${email}`}>{email}</a> : null}
        {instagram ? (
          <a class="font-semibold text-neutral-900 hover:text-[#E05747]" href={instagram} target="_blank" rel="noreferrer">
            Instagram
          </a>
        ) : null}
      </div>
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-[#146D57]">Subscribe</h3>
      <p class="mt-3 max-w-prose text-neutral-700">
        Sign up to stay current on my latest tips, travel stories, and brand work.
      </p>
      <form class="mt-5 flex flex-col gap-3 sm:flex-row" action="#" method="post">
        <input
          class="w-full rounded-md border border-black/15 bg-white px-4 py-3 text-sm outline-none ring-[#E05747]/30 focus:ring-4"
          type="email"
          name="email"
          placeholder="Your email"
          required
        />
        <button
          class="rounded-md bg-[#E05747] px-5 py-3 text-sm font-semibold text-white hover:bg-[#d54f41]"
          type="submit"
        >
          Subscribe
        </button>
      </form>
      <p class="mt-3 text-xs text-neutral-500">
        (Form wiring can be added later: Formspree/Netlify/Vercel.)
      </p>
    </div>
  </div>
</footer>

