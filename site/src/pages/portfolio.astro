---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { getSiteSettings } from "../lib/getSiteSettings";

const data = await getSiteSettings();
const mediaKitUrl = data?.mediaKit?.asset?.url ?? null;
---

<BaseLayout title={`${data?.siteTitle ?? "Hey Mary"} — Portfolio`}>
  <Header logoText={data?.logoText ?? "Hey Mary"} nav={data?.navigation ?? []} activePath="/portfolio" />
  <main>
    <PageHero {...(data?.portfolio ?? {})} />

    <section class="mx-auto max-w-6xl px-5 pb-16">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-black/10 bg-white p-8">
          <h2 class="text-2xl font-semibold" style="font-family: 'Playfair Display', serif;">How We Can Work Together</h2>
          <ul class="mt-5 space-y-4 text-neutral-800">
            {(data?.services ?? []).map((s: any) => (
              <li class="leading-relaxed">
                <span class="font-semibold">{s.title}</span>
                {s.description ? <span class="text-neutral-700">: {s.description}</span> : null}
              </li>
            ))}
          </ul>

          <div class="mt-8">
            {mediaKitUrl ? (
              <a
                class="inline-flex items-center justify-center rounded-md bg-[#E05747] px-5 py-3 text-sm font-semibold text-white hover:bg-[#d54f41]"
                href={mediaKitUrl}
                target="_blank"
                rel="noreferrer"
              >
                Download Media Kit
              </a>
            ) : (
              <button
                class="inline-flex items-center justify-center rounded-md bg-[#E05747] px-5 py-3 text-sm font-semibold text-white opacity-70"
                type="button"
              >
                Download Media Kit (add PDF in CMS)
              </button>
            )}
          </div>
        </div>

        <div class="rounded-2xl border border-black/10 bg-white p-8">
          <h2 class="text-2xl font-semibold" style="font-family: 'Playfair Display', serif;">Testimonials</h2>
          <div class="mt-5 space-y-6">
            {(data?.testimonials ?? []).slice(0, 3).map((t: any) => (
              <figure class="rounded-xl bg-[#FDF9EC] p-5">
                <blockquote class="text-neutral-800">“{t.quote}”</blockquote>
                {(t.name || t.company) ? (
                  <figcaption class="mt-3 text-sm font-semibold text-neutral-900">
                    {t.name ?? "Client"}
                    {t.company ? <span class="font-normal text-neutral-700"> · {t.company}</span> : null}
                  </figcaption>
                ) : null}
              </figure>
            ))}
            {(!data?.testimonials || data.testimonials.length === 0) ? (
              <p class="text-neutral-700">Add testimonials in the CMS to show them here.</p>
            ) : null}
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border border-black/10 bg-white p-8">
        <h2 class="text-lg font-bold uppercase tracking-[0.16em] text-[#146D57]">Brands I’ve worked with</h2>
        <p class="mt-2 text-neutral-700">Logos are editable in the CMS. Replace placeholders anytime.</p>
      </div>
    </section>
  </main>
  <Footer email={data?.social?.email} instagram={data?.social?.instagram} />
</BaseLayout>

