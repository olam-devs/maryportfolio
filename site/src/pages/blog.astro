---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { getSiteSettings } from "../lib/getSiteSettings";

const data = await getSiteSettings();
---

<BaseLayout title={`${data?.siteTitle ?? "Hey Mary"} — Blog`}>
  <Header logoText={data?.logoText ?? "Hey Mary"} nav={data?.navigation ?? []} activePath="/blog" />
  <main>
    <PageHero {...(data?.blog ?? {})} />
    <section class="mx-auto max-w-6xl px-5 pb-16">
      <div class="rounded-2xl border border-black/10 bg-white p-8">
        <h2 class="text-xl font-semibold" style="font-family: 'Playfair Display', serif;">No blog posts yet</h2>
        <p class="mt-3 max-w-prose text-neutral-700">
          This site is rebuilt clean. If you ever want a blog later, we can add it to Sanity — but for now we keep it simple.
        </p>
      </div>
    </section>
  </main>
  <Footer email={data?.social?.email} instagram={data?.social?.instagram} />
</BaseLayout>

