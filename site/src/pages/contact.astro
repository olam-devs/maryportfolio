---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { getSiteSettings } from "../lib/getSiteSettings";

const data = await getSiteSettings();
---

<BaseLayout title={`${data?.siteTitle ?? "Hey Mary"} — Contact`}>
  <Header logoText={data?.logoText ?? "Hey Mary"} nav={data?.navigation ?? []} activePath="/contact" />
  <main>
    <PageHero {...(data?.contact ?? {})} />

    <section class="mx-auto max-w-6xl px-5 pb-16">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-black/10 bg-white p-8">
          <h2 class="text-2xl font-semibold" style="font-family: 'Playfair Display', serif;">Send a message</h2>
          <p class="mt-3 text-neutral-700">
            We can wire this to a real form endpoint whenever you’re ready.
          </p>
          <form class="mt-6 space-y-4" action="#" method="post">
            <input class="w-full rounded-md border border-black/15 px-4 py-3 text-sm" name="name" placeholder="Your name" />
            <input class="w-full rounded-md border border-black/15 px-4 py-3 text-sm" type="email" name="email" placeholder="Your email" required />
            <textarea class="w-full rounded-md border border-black/15 px-4 py-3 text-sm" name="message" rows="6" placeholder="Tell me about your project" required></textarea>
            <button class="rounded-md bg-[#E05747] px-5 py-3 text-sm font-semibold text-white hover:bg-[#d54f41]" type="submit">
              Send
            </button>
          </form>
        </div>

        <div class="rounded-2xl border border-black/10 bg-white p-8">
          <h2 class="text-2xl font-semibold" style="font-family: 'Playfair Display', serif;">Contact</h2>
          <div class="mt-4 space-y-2 text-neutral-800">
            {data?.social?.email ? (
              <p><span class="font-semibold">Email:</span> <a class="hover:text-[#E05747]" href={`mailto:${data.social.email}`}>{data.social.email}</a></p>
            ) : (
              <p class="text-neutral-700">Add a public email in the CMS.</p>
            )}
            {data?.social?.instagram ? (
              <p><span class="font-semibold">Instagram:</span> <a class="hover:text-[#E05747]" href={data.social.instagram} target="_blank" rel="noreferrer">Open</a></p>
            ) : null}
          </div>
          <div class="mt-8 rounded-xl bg-[#FDF9EC] p-5 text-sm text-neutral-700">
            Picture placeholder area (you’ll add an image later).
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer email={data?.social?.email} instagram={data?.social?.instagram} />
</BaseLayout>

